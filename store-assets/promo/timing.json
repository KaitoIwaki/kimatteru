  "lines": [
    {
      "at": 0.3,
      "dur": 2.01,
      "text": "この予定、決まってたっけ？"
    },
    {
      "at": 3.6,
      "dur": 2.91,
      "text": "ふつうのカレンダーは、ぜんぶ同じ見た目なのだ。"
    },
    {
      "at": 7.16,
      "dur": 2.88,
      "text": "ルッコなら、まだは点線、決まったら塗り。"
    },
    {
      "at": 10.24,
      "dur": 0.97,
      "text": "押すだけなのだ！"
    },
    {
      "at": 12.54,
      "dur": 2.28,
      "text": "たぶんの予定も、置いておけるのだ。"
    },
    {
      "at": 15.02,
      "dur": 2.26,
      "text": "BBQやライブは、まだ点線。"
    },
    {
      "at": 17.49,
      "dur": 1.62,
      "text": "決まったバイトは、塗り。"
    },
    {
      "at": 19.39,
      "dur": 2.34,
      "text": "どれが未定か、ひと目で分かるのだ。"
    },
    {
      "at": 22.47,
      "dur": 2.57,
      "text": "点線を押すと、どうなったか聞いてくれる。"
    },
    {
      "at": 25.24,
      "dur": 2.17,
      "text": "確定したで、塗りに変わるのだ。"
    },
    {
      "at": 28.54,
      "dur": 2.89,
      "text": "いつ空いてる？には、空き状況のタブ。"
    },
    {
      "at": 32.18,
      "dur": 3.02,
      "text": "毎日に、丸三角バツが自動で付くのだ。"
    },
    {
      "at": 35.4,
      "dur": 1.48,
      "text": "丸は、予定なし。"
    },
    {
      "at": 37.6,
      "dur": 3.27,
      "text": "三角は、一部あいてる日。空き時間まで出る。"
    },
    {
      "at": 41.08,
      "dur": 2.46,
      "text": "点線の三角は、まだ候補だけ。"
    },
    {
      "at": 43.74,
      "dur": 1.96,
      "text": "だから、すぐ答えられるのだ！"
    },
    {
      "at": 46.45,
      "dur": 2.2,
      "text": "空いてる日だけ、画像で送れる。"
    },
    {
      "at": 48.85,
      "dur": 1.78,
      "text": "予定の中身は見えないのだ。"
    },
    {
      "at": 52.15,
      "dur": 1.26,
      "text": "ウィジェットもあるのだ。"
    },
    {
      "at": 55.45,
      "dur": 2.87,
      "text": "何に時間を使ったか、種類ごとに見える。"
    },
    {
      "at": 59.15,
      "dur": 1.79,
      "text": "給料の目安も分かるのだ。"
    },
    {
      "at": 61.79,
      "dur": 3.62,
      "text": "未定のまま置けるカレンダー、ルッコ。無料なのだ！"
    }
  ]
}