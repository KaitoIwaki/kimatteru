  "lines": [
    {
      "at": 0.3,
      "dur": 3.19,
      "text": "「この予定、決まってたっけ？」ってなること、ありませんか？"
    },
    {
      "at": 4.14,
      "dur": 3.33,
      "text": "ふつうのカレンダーって、ぜんぶ同じ見た目なんですよね。"
    },
    {
      "at": 8.12,
      "dur": 5.08,
      "text": "でもルッコなら、まだの予定は点線、決まった予定は塗り。"
    },
    {
      "at": 13.4,
      "dur": 1.35,
      "text": "決まったら、押すだけです。"
    },
    {
      "at": 15.7,
      "dur": 2.91,
      "text": "「たぶん行く」予定も、そのまま入れておけます。"
    },
    {
      "at": 18.81,
      "dur": 2,
      "text": "バーベキューやライブは、まだ点線。"
    },
    {
      "at": 21.01,
      "dur": 1.35,
      "text": "決まったバイトは、塗り。"
    },
    {
      "at": 22.91,
      "dur": 2.71,
      "text": "どれが決まってないか、ひと目で分かるんです。"
    },
    {
      "at": 26.37,
      "dur": 3.35,
      "text": "点線の予定を押すと、「どうなりました？」って聞いてくれて、"
    },
    {
      "at": 29.92,
      "dur": 2.41,
      "text": "「確定した」を押せば、塗りに変わります。"
    },
    {
      "at": 33.22,
      "dur": 4.67,
      "text": "友だちに「いつ空いてる？」って聞かれたら、空き状況のタブを開いてみてください。"
    },
    {
      "at": 38.65,
      "dur": 4.25,
      "text": "毎日に、まる、さんかく、ばつが、自動で付いているんです。"
    },
    {
      "at": 43.1,
      "dur": 1.47,
      "text": "まるは、予定なしの日。"
    },
    {
      "at": 45.3,
      "dur": 4.86,
      "text": "さんかくは、少しだけ空いている日。何時まで空いているかも出ます。"
    },
    {
      "at": 50.36,
      "dur": 5.27,
      "text": "点線のさんかくは、まだ候補しかない日。まだ動かせる、ということです。"
    },
    {
      "at": 55.82,
      "dur": 3.91,
      "text": "ばつは、もう埋まっている日。だから、すぐ答えられます！"
    },
    {
      "at": 60.48,
      "dur": 3.42,
      "text": "しかも、空いている日だけを画像にして送れちゃいます。"
    },
    {
      "at": 64.1,
      "dur": 2.85,
      "text": "予定の中身は相手に見えないので、安心です。"
    },
    {
      "at": 67.6,
      "dur": 2.06,
      "text": "ホーム画面には、ウィジェットも置けます。"
    },
    {
      "at": 70.9,
      "dur": 3.24,
      "text": "何に時間を使ったかも、種類ごとに見えますし、"
    },
    {
      "at": 74.6,
      "dur": 2.45,
      "text": "バイトの給料の目安まで分かります。"
    },
    {
      "at": 77.9,
      "dur": 3.7,
      "text": "未定のまま置けるカレンダー、ルッコ。App Storeで公開中！"
    }
  ]
}