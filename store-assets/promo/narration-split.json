{
  "source": "narration-gemini.wav",
  "total": 80.92,
  "segments": [
    {
      "i": 1,
      "start": 0.234,
      "end": 3.424,
      "expect": 3.53,
      "text": "「この予定、決まってたっけ？」ってなること、ありませんか？"
    },
    {
      "i": 2,
      "start": 3.766,
      "end": 7.099,
      "expect": 3.81,
      "text": "ふつうのカレンダーって、ぜんぶ同じ見た目なんですよね。"
    },
    {
      "i": 3,
      "start": 7.567,
      "end": 12.643,
      "expect": 4.1,
      "text": "でもルッコなら、まだの予定は点線、決まった予定は塗り。"
    },
    {
      "i": 4,
      "start": 12.899,
      "end": 14.249,
      "expect": 1.74,
      "text": "決まったら、押すだけです。"
    },
    {
      "i": 5,
      "start": 15.1,
      "end": 18.014,
      "expect": 3.04,
      "text": "「たぶん行く」予定も、そのまま入れておけます。"
    },
    {
      "i": 6,
      "start": 18.301,
      "end": 20.297,
      "expect": 2.31,
      "text": "バーベキューやライブは、まだ点線。"
    },
    {
      "i": 7,
      "start": 20.686,
      "end": 22.034,
      "expect": 1.59,
      "text": "決まったバイトは、塗り。"
    },
    {
      "i": 8,
      "start": 22.652,
      "end": 25.367,
      "expect": 3.1,
      "text": "どれが決まってないか、ひと目で分かるんです。"
    },
    {
      "i": 9,
      "start": 25.82,
      "end": 29.169,
      "expect": 3.93,
      "text": "点線の予定を押すと、「どうなりました？」って聞いてくれて、"
    },
    {
      "i": 10,
      "start": 29.726,
      "end": 32.14,
      "expect": 2.7,
      "text": "「確定した」を押せば、塗りに変わります。"
    },
    {
      "i": 11,
      "start": 33.047,
      "end": 37.721,
      "expect": 5.44,
      "text": "友だちに「いつ空いてる？」って聞かれたら、空き状況のタブを開いてみてください。"
    },
    {
      "i": 12,
      "start": 38.056,
      "end": 42.31,
      "expect": 3.7,
      "text": "毎日に、まる、さんかく、ばつが、自動で付いているんです。"
    },
    {
      "i": 13,
      "start": 42.995,
      "end": 44.465,
      "expect": 1.54,
      "text": "まるは、予定なしの日。"
    },
    {
      "i": 14,
      "start": 44.821,
      "end": 49.676,
      "expect": 4.72,
      "text": "さんかくは、少しだけ空いている日。何時まで空いているかも出ます。"
    },
    {
      "i": 15,
      "start": 50.097,
      "end": 55.365,
      "expect": 4.78,
      "text": "点線のさんかくは、まだ候補しかない日。まだ動かせる、ということです。"
    },
    {
      "i": 16,
      "start": 55.613,
      "end": 59.519,
      "expect": 3.53,
      "text": "ばつは、もう埋まっている日。だから、すぐ答えられます！"
    },
    {
      "i": 17,
      "start": 59.981,
      "end": 63.4,
      "expect": 3.84,
      "text": "しかも、空いている日だけを画像にして送れちゃいます。"
    },
    {
      "i": 18,
      "start": 64.078,
      "end": 66.928,
      "expect": 3.47,
      "text": "予定の中身は相手に見えないので、安心です。"
    },
    {
      "i": 19,
      "start": 67.853,
      "end": 69.915,
      "expect": 2.82,
      "text": "ホーム画面には、ウィジェットも置けます。"
    },
    {
      "i": 20,
      "start": 70.311,
      "end": 73.552,
      "expect": 3.44,
      "text": "何に時間を使ったかも、種類ごとに見えますし、"
    },
    {
      "i": 21,
      "start": 74.069,
      "end": 76.519,
      "expect": 2.7,
      "text": "バイトの給料の目安まで分かります。"
    },
    {
      "i": 22,
      "start": 76.879,
      "end": 80.581,
      "expect": 4.21,
      "text": "未定のまま置けるカレンダー、ルッコ。App Storeで公開中！"
    }
  ]
}
