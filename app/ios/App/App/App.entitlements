<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ウィジェットと共有する置き場。ここと、ウィジェット側と、
	     Apple Developer に登録した名前の3つがそろっていないと、
	     エラーも出ずに黙って届かなくなる。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.kimatteru.app</string>
	</array>
	<!-- iCloud 同期（sync.js）。使うのはキーと値の保存だけ（書類やデータベースは使わない）。
	     Apple Developer の App ID に iCloud の許可が要る（tools/asc.mjs caps で足した）。 -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
